# Copy to .env.local for local overrides (never commit secrets or prod hosts if policy requires).
# All vars optional.

# API origin for the SPA. Leave unset for same-origin `/api` (nginx on openvuln.clouditera.com).
# HF / cross-origin static host example:
# VITE_API_BASE_URL=https://openvuln.clouditera.com
# VITE_API_BASE_URL=

# Local development proxy target. Keep VITE_API_BASE_URL unset so browser
# requests stay same-origin and Vite forwards `/api` and `/health` here.
# VITE_API_PROXY=https://openvuln.clouditera.com

# Home page: zai (default, collaborator landing) | product (full deck)
# VITE_LANDING=zai
