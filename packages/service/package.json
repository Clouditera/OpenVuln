{
  "name": "@openvuln/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/infra/db && cp -r src/infra/db/migrations dist/infra/db/",
    "dev": "tsc --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node ./scripts/seed-demo.mjs",
    "seed:demo:reset": "node ./scripts/seed-demo.mjs --reset",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@openvuln/shared": "workspace:*",
    "hono": "^4.7.4",
    "jszip": "^3.10.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
