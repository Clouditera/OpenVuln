# Local development / single-process API (copy to repo root `.env` or export).
# Production split stack: use deploy/.env.prod.example → .env.prod

# Postgres (deploy/docker-compose.yml maps host :5433 → container 5432)
DATABASE_URL=postgresql://openvuln:openvuln@127.0.0.1:5433/openvuln
PORT=7860
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:7860
LOG_LEVEL=info

# VulnHunter (token mode recommended)
VULNHUNTER_BASE_URL=http://127.0.0.1:28080
VULNHUNTER_AUTH_MODE=token
VULNHUNTER_API_TOKEN=
VULNHUNTER_CREDENTIAL_ID=
VULNHUNTER_USERNAME=
VULNHUNTER_PASSWORD=

VH_SOURCE_MODE=archive
VH_SCAN_TIMEOUT_HOURS=24
VH_MAX_ITEMS_PER_RECON=10
VH_AGENT_MAX_PARALLEL=5
VH_ENABLE_DYNAMIC_VERIFY=true
VH_ENABLE_DYNAMIC_EXPLOIT=true

SCAN_CONCURRENCY=2
SCAN_COOLDOWN_DAYS=36500
SCAN_VH_FAIL_GRACE_POLLS=3
SCAN_DISPATCH_STALE_MINUTES=30

ADMIN_TOKEN=
# Optional during dual-write / legacy signed disclose window
ADMIN_PUBLIC_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GITHUB_SERVER_TOKEN=

# GitHub OAuth (owner self-service)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# defaults to ${PUBLIC_BASE_URL}/api/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_STATE_SECRET=
SUBMIT_DAILY_LIMIT=10
