# Copy to .env.prod on the server (mode 600). Never commit real secrets.

POSTGRES_USER=openvuln
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=openvuln

# Optional image tags after local build/load
# OPENVULN_API_IMAGE=openvuln:api
# OPENVULN_WEB_IMAGE=openvuln:web
# WEB_BIND=127.0.0.1:23100
# ENV_FILE=.env.prod

# --- OpenVuln API ---
ADMIN_TOKEN=change-me-admin-token
# base64 PEM public key (admin-cli keygen)
ADMIN_PUBLIC_KEY=

VULNHUNTER_AUTH_MODE=token
VULNHUNTER_BASE_URL=http://host.docker.internal:28080
VULNHUNTER_API_TOKEN=
VULNHUNTER_CREDENTIAL_ID=

VH_SOURCE_MODE=archive
SCAN_CONCURRENCY=10
SCAN_COOLDOWN_DAYS=36500
SCAN_VH_FAIL_GRACE_POLLS=3
SCAN_DISPATCH_STALE_MINUTES=30

PUBLIC_BASE_URL=https://openvuln.clouditera.com
# Same-origin via web nginx — CORS optional; keep HF Static origins if needed
CORS_ALLOWED_ORIGINS=https://openvuln.clouditera.com,https://zai-org-openvuln.static.hf.space,https://zai-org-openvuln.hf.space,https://huggingface.co,https://www.huggingface.co

LOG_LEVEL=info
GITHUB_SERVER_TOKEN=

# GitHub OAuth (owner self-service)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://openvuln.clouditera.com/api/auth/github/callback
GITHUB_OAUTH_STATE_SECRET=
# OAuth domain relay (multi-front-end): front-ends that reverse-proxy /api/*
# through their own domain must exchange the code on THEIR domain; others
# (HF cross-origin) exchange on the canonical origin.
OAUTH_CANONICAL_ORIGIN=https://openvuln.clouditera.com
OAUTH_EXCHANGE_ORIGINS=
SUBMIT_DAILY_LIMIT=10

# Scan-complete email (optional; in-app notifications work without SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_ENABLED=true
