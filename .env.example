# PostgreSQL (required) — demo/dev DB (port 5433 via deploy/docker-compose.yml)
DATABASE_URL=postgresql://openvuln:openvuln@localhost:5433/openvuln
# Tests ALWAYS use openvuln_test (created once). Do not point this at the demo DB.
# TEST_DATABASE_URL=postgresql://openvuln:openvuln@localhost:5433/openvuln_test

# Server
PORT=7860
PUBLIC_BASE_URL=http://localhost:7860
LOG_LEVEL=info
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated browser Origins allowed for CORS (HF Static Space URL, etc.).
# Empty = same-origin only. Use * only for open local dev (credentials disabled).
# CORS_ALLOWED_ORIGINS=https://your-space.hf.space,http://localhost:5173

# VulnHunter integration
VULNHUNTER_BASE_URL=http://localhost:28080
# cookie | token — production uses token (Bearer vht_…)
VULNHUNTER_AUTH_MODE=token
VULNHUNTER_USERNAME=
VULNHUNTER_PASSWORD=
# VULNHUNTER_API_TOKEN=vht_...   # from VH service account (never commit)
# Optional: default LLM credential id on that VH account (required if account has no default)
# VULNHUNTER_CREDENTIAL_ID=

# VH create-task defaults (fish 2026-08-02)
# scan_timeout is sent as seconds; hours here × 3600. timeout_mode=custom always.
VH_SCAN_TIMEOUT_HOURS=24
VH_MAX_ITEMS_PER_RECON=10
VH_AGENT_MAX_PARALLEL=5
VH_AUDIT_FOCUS=全面扫描，确保高覆盖率和高 poc/exp 执行率
# Requires VH sandbox plane; create returns 400 ERR_SANDBOX_NOT_CONFIGURED if missing
VH_ENABLE_DYNAMIC_VERIFY=true
VH_ENABLE_DYNAMIC_EXPLOIT=true
# archive = OpenVuln downloads GitHub zipball + multipart upload (default)
# git = VH clones git_url (may timeout from CN hosts)
VH_SOURCE_MODE=archive
VH_ZIP_MAX_MB=500
VH_ZIP_DOWNLOAD_TIMEOUT_MS=120000

# GitHub (public repo metadata only — OAuth removed)
GITHUB_SERVER_TOKEN=

# Scan queue — max in-flight VH tasks (fish stability default: 4)
SCAN_CONCURRENCY=4
# VH failed polls required before OV marks job failed (transient glitch grace)
SCAN_VH_FAIL_GRACE_POLLS=3
# Stage policy: one scan per project. Use 36500 (≈100y) for "once".
# Future extension: 180-day lock + owner archive unlock — keep this env knob.
SCAN_COOLDOWN_DAYS=36500

# Admin API: Authorization: Bearer <token> on /api/admin/*
ADMIN_TOKEN=

# Crypto admin channel (RSA public key, base64 PEM or raw PEM)
# Generate: pnpm --filter @openvuln/admin-cli exec node dist/cli.js keygen --out admin.pem
ADMIN_PUBLIC_KEY=
